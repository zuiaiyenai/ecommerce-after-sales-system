# Docker Compose and scripts/start-backend.ps1 read this project-level file.
# Project scripts overwrite inherited process variables so another project's
# Windows environment cannot redirect this application to the wrong services.
# Keep layered retrieval disabled until migration, backfill, and safety gates pass.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8080
DB_USERNAME=ecommerce
DB_PASSWORD=local-dev-password
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/ecommerce_aftersales?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Set this to the VM address when Docker Compose runs inside VMware.
KAFKA_ADVERTISED_HOST=localhost
OLLAMA_HOST_PORT=11434
OLLAMA_MAX_LOADED_MODELS=2
VISION_LOCAL_MODEL=qwen2.5vl:3b
VISION_TIMEOUT_SECONDS=300
RERANK_HOST_PORT=8081
RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:5432/after_sales_rag
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=after_sales_rag
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=local-dev-password
AGENT_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8080/api

# dev-start.ps1 uses Docker by default when available. For the current hybrid
# Windows + VMware setup, set LOCAL_INFRA_MODE=Vm in the ignored .env file.
LOCAL_INFRA_MODE=Auto
WINDOWS_MYSQLD_PATH=
WINDOWS_REDIS_SERVER_PATH=
WINDOWS_MYSQLADMIN_PATH=
WINDOWS_MYSQL_SHUTDOWN_USER=root
WINDOWS_MYSQL_SHUTDOWN_PASSWORD=
WINDOWS_REDIS_CLI_PATH=
VM_INFRA_HOST=
VM_INFRA_USER=codex
VM_INFRA_SSH_KEY=.runtime/vm/id_ed25519
VM_INFRA_KNOWN_HOSTS=.runtime/vm/known_hosts
VM_INFRA_COMPOSE_DIR=/opt/ecommerce-after-sales-system

RAG_LAYERED_RETRIEVAL_ENABLED=false
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_PARSE_MAX_REQUEST_BYTES=15029592

AGENT_INTERNAL_TOKEN=replace-with-a-random-shared-secret
# 4 vCPU local models can need more than the production-oriented 90-second default.
AGENT_TIMEOUT_MILLIS=300000
# Keep the client slightly above the Java gateway so it can receive the terminal event.
MINIAPP_AGENT_REQUEST_TIMEOUT_MILLIS=330000

# Enable when Prometheus/Grafana run in the dedicated VMware VM.
VM_OBSERVABILITY_ENABLED=false
VM_WINDOWS_HOST_IP=192.168.100.1

RERANK_PROVIDER=tei
RERANK_BASE_URL=http://127.0.0.1:8081/rerank
RERANK_API_KEY=local-tei
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30
RERANK_MAX_RETRIES=0
RERANK_MAX_CANDIDATES=5
RERANK_MAX_CONCURRENCY=4
RERANK_CIRCUIT_FAILURE_THRESHOLD=5
RERANK_CIRCUIT_RECOVERY_SECONDS=30
LLM_NATIVE_FUNCTION_CALLING_ENABLED=true
LLM_LEGACY_TOOL_CALL_FALLBACK_ENABLED=true
