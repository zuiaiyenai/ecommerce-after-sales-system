{
  "test_config": {
    "name": "RAG 全链路测试配置",
    "version": "1.0.0",
    "description": "用于配置 RAG 全链路测试的参数"
  },
  "retrieval": {
    "top_k_values": [1, 3, 5, 10],
    "retrieval_modes": ["dense", "keyword", "rrf", "rerank"],
    "default_mode": "rerank",
    "timeout_seconds": 30
  },
  "evaluation": {
    "k_values": [1, 3, 5, 10],
    "ndcg_cutoffs": [5, 10],
    "mrr_cutoff": 10,
    "hit_rate_cutoffs": [5, 10]
  },
  "dataset": {
    "min_cases": 10,
    "recommended_cases": 50,
    "max_cases": 1000,
    "require_negative_cases": true,
    "require_filter_labels": true
  },
  "quality_gates": {
    "recall_at_5_min": 0.7,
    "ndcg_at_5_min": 0.6,
    "mrr_at_10_min": 0.5,
    "context_f1_min": 0.6,
    "faithfulness_min": 0.7,
    "accuracy_min": 0.8,
    "latency_p95_max_ms": 5000,
    "error_rate_max": 0.05
  },
  "reporting": {
    "output_dir": "evaluation/reports",
    "format": "markdown",
    "include_details": true,
    "include_charts": false
  }
}
